# DisasterAid Backend Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual secrets.

# PostgreSQL Connection String (Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>)
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/disasteraid

# JWT Configuration
JWT_SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=10

# Default Seed Administrator (for python -m app.services.seed_admin)
ADMIN_NAME=Disaster Assessment Officer
ADMIN_EMAIL=admin@disasteraid.gov
ADMIN_PASSWORD=AdminOfficial2026!
